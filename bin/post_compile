#!/bin/bash
# Scalingo post-compile hook: install Claude Code CLI
#
# The installer creates a symlink with an absolute path to the build dir,
# which won't survive into the runtime container. So we resolve it and
# copy the actual binary to a path that persists.
#
# CACHE_DIR holds a fallback for when downloads.claude.ai is unreachable,
# never the primary path: reusing it while a fresh install is possible
# freezes the CLI version silently across deploys.
#
# Set CLAUDE_CLI_VERSION to pin a known-good version (rollback escape hatch);
# empty means latest.

set -o pipefail

CLAUDE_CACHE="${CACHE_DIR:+$CACHE_DIR/claude-cli}"
TARGET="${CLAUDE_CLI_VERSION:-latest}"
CLAUDE_BIN=""

mkdir -p "$HOME/bin"

echo "-----> Installing Claude Code CLI ($TARGET)"
if curl -fsSL https://claude.ai/install.sh | bash -s "$TARGET" 2>&1; then
    CLAUDE_BIN=$(readlink -f "$HOME/.local/bin/claude" 2>/dev/null)
fi

if [ -x "$CLAUDE_BIN" ]; then
    cp "$CLAUDE_BIN" "$HOME/bin/claude"
    if [ -n "$CLAUDE_CACHE" ]; then
        cp "$CLAUDE_BIN" "$CLAUDE_CACHE"
        echo "-----> Refreshed Claude Code CLI cache"
    fi
elif [ -n "$CLAUDE_CACHE" ] && [ -x "$CLAUDE_CACHE" ]; then
    echo "-----> WARNING: install failed, falling back to the cached CLI (stale version)"
    cp "$CLAUDE_CACHE" "$HOME/bin/claude"
else
    echo "-----> ERROR: no Claude Code CLI available (install failed, no usable cache)" >&2
    exit 1
fi

chmod +x "$HOME/bin/claude"
"$HOME/bin/claude" --version || true

# Scalingo rejects images over 2 GB. The installer's own copy of the CLI (~280 MB) is
# dead weight once copied to bin/, and so are the dependencies' test suites (~165 MB):
# nothing imports a tests/ package at runtime.
rm -rf "$HOME/.local/share/claude" "$HOME/.local/bin/claude"
find "$HOME/.scalingo/python/lib" -path '*/site-packages/*' -type d -name tests -prune -exec rm -rf {} +
echo "-----> Removed the installer's CLI copy and the dependencies' test suites"

# Mark onboarding as complete so the CLI skips the interactive setup wizard
# (theme selection, login method) which doesn't work in non-interactive terminals.
# Auth is handled via CLAUDE_CODE_OAUTH_TOKEN env var instead.
echo '{"hasCompletedOnboarding":true}' > "$HOME/.claude.json"
echo "-----> Created ~/.claude.json (onboarding bypass)"

"$(dirname "$0")/install_playwright_browser.sh" \
    || echo "-----> WARNING: Playwright browser not installed, verify_dashboard will exit 2"
